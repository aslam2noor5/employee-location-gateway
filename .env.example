# ============================================================
# Employee Location Gateway - Environment Variables
# ============================================================

# Supabase project URL (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key (safe to include in the frontend)
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ------------------------------------------------------------
# ملاحظة: الخرائط داخل اللوحة تُعرض عبر Leaflet + OpenStreetMap
# مجانية بالكامل ولا تحتاج أي مفتاح API.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Secrets used ONLY inside Supabase Edge Functions
# (set them in Dashboard → Edge Functions → Secrets — NEVER here)
# ------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY  — used by edge functions (server-side only)
# LINKS_TOKEN_KEY            — AES key secret used to encrypt link tokens